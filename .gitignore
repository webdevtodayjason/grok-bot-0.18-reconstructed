node_modules/
/.cache/
/.build/
/dist/
/src/app/dist/
/recovered/
/recovery/
/reports/
/work/
.DS_Store
*.log

# Machine-local harness and inspection scratch.
/.tmp*/
/.grok-*/
/.playwright-cli/
/.tmp-*.mjs
/frontend/.tmp-*/
/.http-probe.*/
/.mcp-bridge.*/
/.openrouter-probe.*/
/.router-*/

# One-off extracted bundle copies at the repository root. Canonical payloads
# live under src/app/dist and recovered/frontend.
/host-main.cjs
/main.cjs
/index-*.js
/katex-*.js
/mermaid.core-*.js
/xlsx-*.js
/index.html
ui/endpoints.json
ui/subscriptions.json
ui/auth.json
# Agent email: the settings file carries the Resend key and the webhook signing
# secret, and the ledger is this operator's own received mail (MAIL-1).
ui/mail.json
ui/mail-inbox.jsonl
# Who knocked on this console's doors, and the key its digests are made under (ADMIN-1). The
# ledger holds addresses and the key is a secret; neither belongs in anybody's clone.
ui/login-attempts.jsonl
ui/login-attempts.jsonl.1
ui/login-attempt-salt

# a build artifact once landed here from an undefined output path (GATE-3)
undefined/

# Orca/OMX worker hook state, created when a worker runs in this worktree
.omx/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# The control plane's own store, when a verb is run without CP_DATA_DIR and it lands in the repo
# root. It holds accounts, the change record and, since FEEDBACK-1, the repository token: a file
# that must never reach anybody's clone, and it appears whenever somebody runs cp/cli.mjs here.
/control-plane.sqlite
/control-plane.sqlite-shm
/control-plane.sqlite-wal
