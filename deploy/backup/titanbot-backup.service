[Unit]
Description=Titanbot instance snapshot (volumes, relay side, control plane and tenants)
Documentation=file://%h/titanbot/deploy/backup/snapshot.sh
# The destination is a mounted array. Without this the job would run at boot before the mount and
# refuse (snapshot.sh checks mountpoint), which is the safe direction but a nightly failure mail.
RequiresMountsFor=/mnt/rosa-storage

[Service]
Type=oneshot
# A snapshot pauses the box, and the control plane for the moment its account store takes to copy,
# so it must not run while a deploy is recreating either; both pauses are seconds and the whole run
# is minutes, and this ceiling only stops a wedged copy holding them.
TimeoutStartSec=30min
Environment=TITANBOT_BACKUP_DEST=/mnt/rosa-storage/archives/titanbot/backups
Environment=TITANBOT_INSTANCE=titanbot
Environment=TITANBOT_ROOT=%h/titanbot
# The control plane's account store and one directory per customer. Written out rather than left to
# the script's default, so what this job covers is readable in the job.
Environment=TITANBOT_TENANT_ROOT=/data/titanbot
ExecStart=/bin/bash %h/titanbot/deploy/backup/snapshot.sh
Nice=10
IOSchedulingClass=idle
